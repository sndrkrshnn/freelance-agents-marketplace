NODE_ENV=test
PORT=5001
API_BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=freelancemarket
DB_USER=freelancemarket
DB_PASSWORD=
DATABASE_URL=postgresql://freelancemarket@localhost:5432/freelancemarket
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# JWT Configuration
JWT_SECRET=test_jwt_secret_key_for_testing_purposes_32chars
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Stripe Configuration (Mock)
STRIPE_SECRET_KEY=sk_test_dummy_key_for_testing
STRIPE_WEBHOOK_SECRET=whsec_dummy_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_dummy_publishable_key

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging Configuration
LOG_LEVEL=error
LOG_FORMAT=text

# Security Configuration
CORS_ORIGIN=http://localhost:3000
HELMET_ENABLED=false

# Redis Configuration (Optional - may not be available)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload Configuration
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_DIR=/tmp/test-uploads

# Push Notifications (Mock)
VAPID_PUBLIC_KEY=test_vapid_public_key
VAPID_PRIVATE_KEY=test_vapid_private_key
VAPID_EMAIL=test@example.com

# Admin Configuration
ADMIN_EMAIL=admin@test.com
ADMIN_SECRET=test_admin_secret
